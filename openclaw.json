{
  "agents": {
    "defaults": {
      "workspace": "./workspace",
      "model": "anthropic/claude-sonnet-4-20250514",
      "heartbeat": {
        "enabled": true,
        "cron": "0 8 * * *",
        "timezone": "Asia/Kolkata"
      }
    }
  },
  "channels": {
    "telegram": {
      "token": "${TELEGRAM_BOT_TOKEN}",
      "allowFrom": ["${TELEGRAM_CHAT_ID}"]
    }
  },
  "skills": {
    "load": {
      "extraDirs": ["./workspace/skills"]
    }
  },
  "contractclaw": {
    "llm": {
      "provider": "${LLM_PROVIDER}",
      "models": {
        "anthropic": "${ANTHROPIC_MODEL}",
        "gemini": "${GEMINI_MODEL}",
        "bedrock": "${BEDROCK_MODEL_ID}"
      },
      "extraction": {
        "maxTokens": 4096,
        "temperature": 0
      },
      "query": {
        "maxTokens": 1024,
        "temperature": 0.3
      }
    },
    "alerts": {
      "thresholds": [30, 7, 1],
      "timezone": "Asia/Kolkata",
      "digestTime": "08:00"
    },
    "registry": {
      "dir": "./workspace/registry"
    },
    "upload": {
      "maxSizeMb": 10,
      "allowedTypes": ["pdf", "docx"]
    }
  }
}
