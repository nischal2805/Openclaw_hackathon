{
  "agents": {
    "defaults": {
      "workspace": "./workspace",
      "model": "amazon-bedrock/minimax.minimax-m2.5",
      "heartbeat": {
        "every": "0 8 * * *"
      }
    }
  },
  "channels": {
    "telegram": {
      "token": "${TELEGRAM_BOT_TOKEN}",
      "allowFrom": ["${TELEGRAM_CHAT_ID}"]
    }
  },
  "skills": {
    "load": {
      "extraDirs": ["./workspace/skills"]
    }
  }
}
