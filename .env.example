# ============================================================
# ContractClaw — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── LLM Provider ────────────────────────────────────────────
# Choose your AI backend: anthropic | gemini | bedrock
# Default: anthropic
LLM_PROVIDER=anthropic

# ── Anthropic (LLM_PROVIDER=anthropic) ──────────────────────
# Get from: https://console.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=sk-ant-...
# Model to use (default used if not set)
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Google Gemini (LLM_PROVIDER=gemini) ─────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# ── AWS Bedrock (LLM_PROVIDER=bedrock) ──────────────────────
# Create IAM user with AmazonBedrockFullAccess policy
# Get keys from: AWS Console → IAM → Users → Security credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Enable model access in: AWS Console → Bedrock → Model access
# MiniMax M2.5 on Bedrock (must be enabled in AWS Console → Bedrock → Model access)
BEDROCK_MODEL_ID=minimax.minimax-m2.5

# ── Telegram ─────────────────────────────────────────────────
# Bot token: message @BotFather on Telegram → /newbot
TELEGRAM_BOT_TOKEN=
# Your chat ID: message @userinfobot on Telegram
TELEGRAM_CHAT_ID=
# Optional: comma-separated chat IDs for alert broadcasts
ALERT_RECIPIENTS=

# ── OpenClaw ─────────────────────────────────────────────────
OPENCLAW_WORKSPACE=./workspace
